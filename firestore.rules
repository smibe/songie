rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function hasActiveMembership() {
      return request.auth != null
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.active == true;
    }

    function isFriend() {
      return hasActiveMembership()
        && get(memberPath(request.auth.uid)).data.role in ['friend', 'admin'];
    }

    function isAdmin() {
      return hasActiveMembership()
        && get(memberPath(request.auth.uid)).data.role == 'admin';
    }

    function validSong(data) {
      return data.keys().hasAll([
          'title',
          'artist',
          'key',
          'chordPro',
          'titleSearch',
          'published',
          'visibility',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.artist is string
        && data.key is string
        && data.chordPro is string
        && data.chordPro.size() <= 900000
        && data.titleSearch is string
        && data.published is bool
        && data.visibility in ['public', 'friends', 'private']
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /songs/{songId} {
      // Admins can inspect all songs. Other users can only read published
      // public songs or published friend-circle songs.
      allow get, list: if isAdmin()
        || (
          resource.data.published == true
          && resource.data.visibility == 'public'
        )
        || (
          resource.data.published == true
          && isFriend()
          && resource.data.visibility in ['public', 'friends']
        );

      // Only admins can change the shared catalog.
      allow create: if isAdmin() && validSong(request.resource.data);
      allow update: if isAdmin()
        && validSong(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    function isApprovedSongieMember() {
      return request.auth != null
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.active == true
        && get(memberPath(request.auth.uid)).data.role in ['friend', 'admin'];
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function songPath(songId) {
      return /databases/$(database)/documents/songs/$(songId);
    }

    function isRoomParticipant(roomId) {
      return isApprovedSongieMember()
        && exists(roomPath(roomId))
        && get(roomPath(roomId)).data.participantUids
          .hasAny([request.auth.uid]);
    }

    function isRoomOwner(roomId) {
      return isRoomParticipant(roomId)
        && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }

    function isGroupReadableSong(songId) {
      return songId is string
        && exists(songPath(songId))
        && get(songPath(songId)).data.published == true
        && get(songPath(songId)).data.visibility in ['public', 'friends'];
    }

    match /rooms/{roomId} {
      function validRoomCreate() {
        return request.resource.data.keys().hasAll([
            'name',
            'ownerUid',
            'ownerName',
            'status',
            'participantUids',
            'currentSongId',
            'currentSongTitle',
            'currentSongArtist',
            'selectedByUid',
            'selectedByName',
            'selectedAt',
            'closedAt',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name',
            'ownerUid',
            'ownerName',
            'status',
            'participantUids',
            'currentSongId',
            'currentSongTitle',
            'currentSongArtist',
            'selectedByUid',
            'selectedByName',
            'selectedAt',
            'closedAt',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 60
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerName
            == get(memberPath(request.auth.uid)).data.displayName
          && request.resource.data.status == 'active'
          && request.resource.data.participantUids == [request.auth.uid]
          && request.resource.data.currentSongId == null
          && request.resource.data.currentSongTitle == null
          && request.resource.data.currentSongArtist == null
          && request.resource.data.selectedByUid == null
          && request.resource.data.selectedByName == null
          && request.resource.data.selectedAt == null
          && request.resource.data.closedAt == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function roomSongMetadataMatches(songId) {
        return request.resource.data.currentSongTitle
            == get(songPath(songId)).data.title
          && request.resource.data.currentSongArtist
            == get(songPath(songId)).data.artist;
      }

      function validRoomSongUpdate() {
        return isRoomOwner(roomId)
          && resource.data.status == 'active'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'currentSongId',
              'currentSongTitle',
              'currentSongArtist',
              'selectedByUid',
              'selectedByName',
              'selectedAt',
              'updatedAt'
            ])
          && isGroupReadableSong(request.resource.data.currentSongId)
          && roomSongMetadataMatches(request.resource.data.currentSongId)
          && request.resource.data.selectedByUid == request.auth.uid
          && request.resource.data.selectedByName
            == get(memberPath(request.auth.uid)).data.displayName
          && request.resource.data.selectedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function validRoomClose() {
        return isRoomOwner(roomId)
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'closedAt', 'updatedAt'])
          && request.resource.data.status == 'closed'
          && request.resource.data.closedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function validRoomJoin() {
        return isApprovedSongieMember()
          && resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantUids', 'updatedAt'])
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.size()
            == resource.data.participantUids.size() + 1
          && request.resource.data.participantUids
            .hasAll(resource.data.participantUids)
          && !resource.data.participantUids.hasAny([request.auth.uid])
          && request.resource.data.participantUids.hasAny([request.auth.uid])
          && request.resource.data.participantUids.size() <= 30
          && request.resource.data.updatedAt == request.time;
      }

      function validRoomLeave() {
        return isApprovedSongieMember()
          && resource.data.status == 'active'
          && resource.data.ownerUid != request.auth.uid
          && resource.data.participantUids.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participantUids', 'updatedAt'])
          && request.resource.data.participantUids is list
          && request.resource.data.participantUids.size()
            == resource.data.participantUids.size() - 1
          && resource.data.participantUids
            .hasAll(request.resource.data.participantUids)
          && !request.resource.data.participantUids.hasAny([request.auth.uid])
          && request.resource.data.updatedAt == request.time;
      }

      // A signed-in, approved member can resolve a known invitation code.
      // Room lists are restricted to rooms whose participant array contains
      // the current user.
      allow get: if isApprovedSongieMember();
      allow list: if isApprovedSongieMember()
        && resource.data.participantUids.hasAny([request.auth.uid]);

      allow create: if isApprovedSongieMember() && validRoomCreate();
      allow update: if validRoomSongUpdate()
        || validRoomClose()
        || validRoomJoin()
        || validRoomLeave();
      allow delete: if false;

      match /participants/{participantUid} {
        function roomContainsParticipant(uid) {
          return getAfter(roomPath(roomId)).data.participantUids
            .hasAny([uid]);
        }

        allow get, list: if isApprovedSongieMember()
          && isRoomParticipant(roomId);

        allow create: if isApprovedSongieMember()
          && request.auth.uid == participantUid
          && roomContainsParticipant(participantUid)
          && request.resource.data.keys().hasAll([
            'uid',
            'displayName',
            'email',
            'role',
            'openedSongId',
            'lastOpenedSongAt',
            'joinedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'uid',
            'displayName',
            'email',
            'role',
            'openedSongId',
            'lastOpenedSongAt',
            'joinedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName
            == get(memberPath(request.auth.uid)).data.displayName
          && request.resource.data.email
            == get(memberPath(request.auth.uid)).data.email
          && request.resource.data.role
            == (
              getAfter(roomPath(roomId)).data.ownerUid == request.auth.uid
                ? 'owner'
                : 'member'
            )
          && request.resource.data.openedSongId == null
          && request.resource.data.lastOpenedSongAt == null
          && request.resource.data.joinedAt == request.time;

        allow update: if isApprovedSongieMember()
          && request.auth.uid == participantUid
          && isRoomParticipant(roomId)
          && get(roomPath(roomId)).data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['openedSongId', 'lastOpenedSongAt'])
          && request.resource.data.openedSongId
            == get(roomPath(roomId)).data.currentSongId
          && isGroupReadableSong(request.resource.data.openedSongId)
          && request.resource.data.lastOpenedSongAt == request.time;

        allow delete: if isApprovedSongieMember()
          && request.auth.uid == participantUid
          && !getAfter(roomPath(roomId)).data.participantUids
            .hasAny([request.auth.uid]);
      }
    }

    match /members/{memberUid} {
      function validDisplayName(value) {
        return value is string
          && value.size() >= 2
          && value.size() <= 80;
      }

      function validSelfProfileCreate() {
        return request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.keys().hasAll([
            'email',
            'displayName',
            'role',
            'active',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'email',
            'displayName',
            'role',
            'active',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.email == request.auth.token.email
          && validDisplayName(request.resource.data.displayName)
          && request.resource.data.role == 'none'
          && request.resource.data.active == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function validSelfProfileUpdate() {
        return request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'displayName', 'updatedAt'])
          && request.resource.data.email == request.auth.token.email
          && validDisplayName(request.resource.data.displayName)
          && request.resource.data.get('role', 'none')
            == resource.data.get('role', 'none')
          && request.resource.data.get('active', false)
            == resource.data.get('active', false)
          && request.resource.data.updatedAt == request.time;
      }

      function validAdminRoleUpdate() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'active', 'updatedAt'])
          && request.resource.data.role in ['none', 'friend', 'admin']
          && request.resource.data.active is bool
          && request.resource.data.active
            == (request.resource.data.role in ['friend', 'admin'])
          && request.resource.data.updatedAt == request.time
          // Never allow an administrator to remove their own admin access.
          // They can change another administrator's role while retaining
          // their own access, so at least one administrator remains.
          && (
            memberUid != request.auth.uid
            || (
              request.resource.data.role == 'admin'
              && request.resource.data.active == true
            )
          );
      }

      // Reading one's own membership is the bootstrap path used by the app.
      // Keep get self-only; isAdmin() itself reads this same membership doc.
      allow get: if request.auth != null && request.auth.uid == memberUid;
      // The admin collection query powers the in-app role manager.
      allow list: if isAdmin();

      // New users may create only a no-access profile for themselves. Existing
      // users may edit only their own name and email. Administrators may change
      // role/active fields, but cannot edit another user's profile details.
      allow create: if validSelfProfileCreate();
      allow update: if validSelfProfileUpdate() || validAdminRoleUpdate();
      allow delete: if false;
    }
  }
}
