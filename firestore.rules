rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function hasActiveMembership() {
      return request.auth != null
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.active == true;
    }

    function isFriend() {
      return hasActiveMembership()
        && get(memberPath(request.auth.uid)).data.role in ['friend', 'admin'];
    }

    function isAdmin() {
      return hasActiveMembership()
        && get(memberPath(request.auth.uid)).data.role == 'admin';
    }

    function validSong(data) {
      return data.keys().hasAll([
          'title',
          'artist',
          'key',
          'chordPro',
          'titleSearch',
          'published',
          'visibility',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.artist is string
        && data.key is string
        && data.chordPro is string
        && data.chordPro.size() <= 900000
        && data.titleSearch is string
        && data.published is bool
        && data.visibility in ['public', 'friends', 'private']
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /songs/{songId} {
      // Admins can inspect all songs. Other users can only read published
      // public songs or published friend-circle songs.
      allow get, list: if isAdmin()
        || (
          resource.data.published == true
          && resource.data.visibility == 'public'
        )
        || (
          resource.data.published == true
          && isFriend()
          && resource.data.visibility in ['public', 'friends']
        );

      // Only admins can change the shared catalog.
      allow create: if isAdmin() && validSong(request.resource.data);
      allow update: if isAdmin()
        && validSong(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /members/{memberUid} {
      // Reading one's own membership is the bootstrap path used by the app.
      // Do not call isAdmin() here: that helper reads this same document and
      // would make this rule recursively evaluate itself.
      allow get: if request.auth != null && request.auth.uid == memberUid;

      // Membership is managed only by the trusted Admin SDK utilities.
      // Client-side users, including admins, cannot list or mutate members.
      allow list, create, update, delete: if false;
    }
  }
}
