rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }

    function hasActiveMembership() {
      return request.auth != null
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.active == true;
    }

    function isFriend() {
      return hasActiveMembership()
        && get(memberPath(request.auth.uid)).data.role in ['friend', 'admin'];
    }

    function isAdmin() {
      return hasActiveMembership()
        && get(memberPath(request.auth.uid)).data.role == 'admin';
    }

    function validSong(data) {
      return data.keys().hasAll([
          'title',
          'artist',
          'key',
          'chordPro',
          'titleSearch',
          'published',
          'visibility',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.artist is string
        && data.key is string
        && data.chordPro is string
        && data.chordPro.size() <= 900000
        && data.titleSearch is string
        && data.published is bool
        && data.visibility in ['public', 'friends', 'private']
        && data.schemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /songs/{songId} {
      // Admins can inspect all songs. Other users can only read published
      // public songs or published friend-circle songs.
      allow get, list: if isAdmin()
        || (
          resource.data.published == true
          && resource.data.visibility == 'public'
        )
        || (
          resource.data.published == true
          && isFriend()
          && resource.data.visibility in ['public', 'friends']
        );

      // Only admins can change the shared catalog.
      allow create: if isAdmin() && validSong(request.resource.data);
      allow update: if isAdmin()
        && validSong(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    match /members/{memberUid} {
      function validDisplayName(value) {
        return value is string
          && value.size() >= 2
          && value.size() <= 80;
      }

      function validSelfProfileCreate() {
        return request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.keys().hasAll([
            'email',
            'displayName',
            'role',
            'active',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'email',
            'displayName',
            'role',
            'active',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.email == request.auth.token.email
          && validDisplayName(request.resource.data.displayName)
          && request.resource.data.role == 'none'
          && request.resource.data.active == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      function validSelfProfileUpdate() {
        return request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['email', 'displayName', 'updatedAt'])
          && request.resource.data.email == request.auth.token.email
          && validDisplayName(request.resource.data.displayName)
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active
          && request.resource.data.updatedAt == request.time;
      }

      function validAdminRoleUpdate() {
        return isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'active', 'updatedAt'])
          && request.resource.data.role in ['none', 'friend', 'admin']
          && request.resource.data.active is bool
          && request.resource.data.active
            == (request.resource.data.role in ['friend', 'admin'])
          && request.resource.data.updatedAt == request.time
          // Never allow an administrator to remove their own admin access.
          // They can change another administrator's role while retaining
          // their own access, so at least one administrator remains.
          && (
            memberUid != request.auth.uid
            || (
              request.resource.data.role == 'admin'
              && request.resource.data.active == true
            )
          );
      }

      // Reading one's own membership is the bootstrap path used by the app.
      // Keep get self-only; isAdmin() itself reads this same membership doc.
      allow get: if request.auth != null && request.auth.uid == memberUid;
      // The admin collection query powers the in-app role manager.
      allow list: if isAdmin();

      // New users may create only a no-access profile for themselves. Existing
      // users may edit only their own name and email. Administrators may change
      // role/active fields, but cannot edit another user's profile details.
      allow create: if validSelfProfileCreate();
      allow update: if validSelfProfileUpdate() || validAdminRoleUpdate();
      allow delete: if false;
    }
  }
}
